{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-commit-trailers.sh",
            "timeout": 15,
            "statusMessage": "Проверка разметки коммита"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/check-context-budget.py",
            "timeout": 10,
            "statusMessage": "Проверка бюджета холодного старта"
          }
        ]
      }
    ]
  }
}