__pycache__/
*.pyc
.env
.venv/
venv/


# large uncompressed microscope images (keep local; use git-LFS if needed)
*.bmp

# литература: PDF первоисточников (чужой copyright, ~22МБ; извлечённый текст — в research/literature/txt/)
# каталог переименован 2026-08-09 (решение В-3): было research/papers/litrev/pdfs/
research/literature/litrev/pdfs/

# рабочие сеансы attenuator_app: журнал, метафайлы, графики каждого запуска
runs/

# PyInstaller build-артефакты GUI-приложения attenuator_app (gui.spec трекается,
# распакованный build/ и собранный dist/*.exe - нет: воспроизводимо из спеки)
attenuator_app/build/
attenuator_app/dist/

# файловые мьютексы координации (CHARTER §12) - эфемерное локальное состояние,
# коммит/пуш случайного .lock перманентно "занял бы" роль для всех, кто клонирует/тянет
coordination/sessions/*.lock

# LaTeX build-артефакты (исходники .tex и итоговые .pdf трекаются)
*.aux
*.log
*.out
*.toc
*.synctex.gz
*.fls
*.fdb_latexmk

# вывод пайплайна: config.RESULTS_DIR = <корень>/results, перезаписывается каждым прогоном.
# Прогоны июля 2026 не воспроизводимы (2D-ветка сломана с 19.07) и сохранены в
# archive/results-2026-07/. Результат, который стоит сохранить, идёт в research/results/<задача>/
# к своей роли-владельцу, а не сюда.
/results/
# каталог "черновик" в корне не заводить: у всего в git должен быть владелец (OWNERSHIP.md)
/scratch/

# archive/ трекается ЦЕЛИКОМ, включая журналы прогонов, которые иначе попали бы под *.log выше
!archive/**

# изолированные worktree фоновых работников Claude Code (74 МБ локального состояния).
# Игнорируем именно worktrees/, а не весь .claude/ — если позже появятся .claude/settings.json
# или .claude/agents/, они должны быть видны в статусе, а не молча пропасть.
.claude/worktrees/

# рабочие промты/отчёты ORCH в корне репозитория (per-заход переписка с владельцем,
# не координационное состояние — то живёт в coordination/) - только корень, не рекурсивно
/PROMPT_*.md
/REPORT_*.md
/*_REVIEW_*.md
/commits_review_*.txt
